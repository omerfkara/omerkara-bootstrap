# Orchestrator deploy tanımı — {{PROJECT}}
# Tek tanım kaynağı: 'omk deploy' ve orchestrator kaydı bu dosyayı okur.
# Not: yalnızca 'anahtar: değer' ve girintili eşlemeler kullanın; PyYAML'ı
# olmayan makinelerde (Pi) yedek ayrıştırıcı liste sözdizimini desteklemez.
project: {{PROJECT}}
repo: {{GITHUB_REPO}}
type: {{PTYPE}}
runner: {{DEPLOY_RUNNER}}        # macos | ubuntu | pi
branch: main
trigger: push

environments:
  staging:
    branch: develop
  production:
    branch: main
    approval: manual

# Sertifika, SSH anahtarı ve store credential'ları orchestrator'da tutulur.
